-- =============================================
local visTab = tabContents[2]

-- RGB перелив
local rgbEnabled = false
local rgbSpeed = 1.2

local function updateRGB()
    if not rgbEnabled or not Player.Character then return end
    local hue = (tick() * rgbSpeed) % 1
    local color = Color3.fromHSV(hue, 1, 1)
    for _, part in pairs(Player.Character:GetChildren()) do
        if part:IsA("BasePart") and (part.Name == "Right Arm" or part.Name == "Left Arm" or part.Name == "Torso") then
            part.Color = color
        end
    end
    local tool = Player.Character:FindFirstChildWhichIsA("Tool")
    if tool then
        for _, part in pairs(tool:GetChildren()) do
            if part:IsA("BasePart") then
                part.Color = Color3.fromHSV((hue + 0.3) % 1, 1, 1)
            end
        end
    end
end

createToggle(visTab, "🌈 RGB перелив (руки+оружие)", 10, false, function(s)
    rgbEnabled = s
    if not s then
        if Player.Character then
            for _, part in pairs(Player.Character:GetChildren()) do
                if part:IsA("BasePart") then part.Color = Color3.fromRGB(255,255,255) end
            end
            local tool = Player.Character:FindFirstChildWhichIsA("Tool")
            if tool then
                for _, part in pairs(tool:GetChildren()) do
                    if part:IsA("BasePart") then part.Color = Color3.fromRGB(255,255,255) end
                end
            end
        end
    end
end)

-- ESP ников (имена над головами)
local nameEspEnabled = false
local nameEspList = {}

local function createNameESP(player)
    if player == Player then return end
    if nameEspList[player] then return end
    local text = Drawing.new("Text")
    text.Text = player.Name
    text.Size = 18
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    text.Center = true
    text.Transparency = 0.8
    nameEspList[player] = text
end

local function updateNameESP()
    for plr, text in pairs(nameEspList) do
        if plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)
            if onScreen and nameEspEnabled then
                text.Position = Vector2.new(pos.X, pos.Y - 50)
                text.Visible = true
            else
                text.Visible = false
            end
        else
            text.Visible = false
        end
    end
end

createToggle(visTab, "👤 ESP ников (имена)", 60, false, function(s)
    nameEspEnabled = s
    if s then
        for _, plr in pairs(game.Players:GetPlayers()) do createNameESP(plr) end
    else
        for _, text in pairs(nameEspList) do text:Remove() end
        nameEspList = {}
    end
end)

